# ====================================================================
# LedgerGuard Local Development Environment Configuration Template
# ====================================================================
# Instructions:
# 1. Copy this template to .env:
#      Windows:     Copy-Item .env.example .env
#      Linux/macOS: cp .env.example .env
# 2. Fill in local passwords in .env.
# 3. The actual .env file is intentionally ignored by Git and must never be committed.

# PostgreSQL Root / Superuser Configuration
POSTGRES_DB=ledgerguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Application-Specific PostgreSQL Credentials (Local Development)
LEDGERGUARD_DB_USER=ledgerguard_app
LEDGERGUARD_DB_PASSWORD=

PSP_DB_USER=psp_simulator_app
PSP_DB_PASSWORD=

NOTIFICATION_DB_USER=notification_worker_app
NOTIFICATION_DB_PASSWORD=

# Application Security (Phase 4)
LEDGERGUARD_JWT_SECRET=

# Development OPS Account Bootstrap (Local Development Only)
# Explicitly enabled only for local development/demonstration. Never enabled in production.
# When enabled, email and password are required (min 12 chars, max 72 UTF-8 bytes).
LEDGERGUARD_OPS_BOOTSTRAP_ENABLED=false
LEDGERGUARD_OPS_BOOTSTRAP_EMAIL=ops@ledgerguard.local
LEDGERGUARD_OPS_BOOTSTRAP_PASSWORD=
LEDGERGUARD_OPS_BOOTSTRAP_FULL_NAME=Operations Engineer

# Kafka Configuration
KAFKA_PORT=29092

# PSP Webhook Security (Phase 22)
PSP_WEBHOOK_SECRET=
PSP_WEBHOOK_URL=http://localhost:8080/api/provider/webhooks

# Observability Infrastructure (Phase 31)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Mailpit Local Email Testing (Phase 32)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ====================================================================
# SMTP Email Notification Relay Configuration
# ====================================================================
# Default configuration uses local Mailpit (smtp://localhost:1025).
# For authenticated external SMTP relay (e.g., AWS SES, Postmark, Mailgun, or standard SMTP relay):
#   MAIL_HOST=smtp.example.com
#   MAIL_PORT=587
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS_ENABLED=true
#   MAIL_STARTTLS_REQUIRED=true
#   MAIL_USERNAME=<your-smtp-username>
#   MAIL_PASSWORD=<your-smtp-password>
#   MAIL_FROM=<your-verified-sender-email>
#   MAIL_FROM_NAME=LedgerGuard
#   MAIL_REPLY_TO=support@yourdomain.com
#
# Optional Gmail SMTP development example (requires Google App Password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS_ENABLED=true
#   MAIL_STARTTLS_REQUIRED=true
#   MAIL_USERNAME=<your-gmail-address>
#   MAIL_PASSWORD=<your-google-app-password>
#   MAIL_FROM=<your-gmail-address>
#
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_STARTTLS_REQUIRED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ledgerguard.local
MAIL_FROM_NAME=LedgerGuard
MAIL_REPLY_TO=
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_READ_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000
