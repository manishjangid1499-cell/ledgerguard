    {
      "id": 3,
      "title": "Average HTTP Request Duration",
      "description": "Aggregate mean request execution duration across all endpoints computed from sum of request seconds divided by count.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerguard-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ledgerguard-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1e-12)",
