# ====================================================================
# LedgerGuard Production Compose Environment Configuration Template
# ====================================================================
# Instructions:
# 1. Copy this template to .env before starting the production stack:
#      Windows:     Copy-Item .env.prod.example .env
#      Linux/macOS: cp .env.prod.example .env
# 2. Fill in secure high-entropy secrets and passwords for all empty fields.
# 3. The .env file is strictly ignored by Git and must never be committed.
# ====================================================================

# PostgreSQL Root Superuser
POSTGRES_DB=ledgerguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Isolated Application Database Credentials
LEDGERGUARD_DB_USER=ledgerguard_app
LEDGERGUARD_DB_PASSWORD=

PSP_DB_USER=psp_simulator_app
PSP_DB_PASSWORD=

NOTIFICATION_DB_USER=notification_worker_app
NOTIFICATION_DB_PASSWORD=

# Application Security (JWT Signing Key - Minimum 256-bit high entropy)
LEDGERGUARD_JWT_SECRET=

# Optional browser origins for deployments where the frontend and API are on
# different origins. Leave blank for the recommended same-origin Nginx setup.
LEDGERGUARD_CORS_ALLOWED_ORIGINS=

# PSP Webhook HMAC SHA-256 Secret (Shared between API and PSP Simulator)
PSP_WEBHOOK_SECRET=

# Observability Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Notification email is disabled until a real SMTP provider is configured.
NOTIFICATION_EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=no-reply@example.com
MAIL_REPLY_TO=

# Public edge ports and loopback-only internal observability/debug ports.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
INTERNAL_BIND_ADDRESS=127.0.0.1
PSP_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
